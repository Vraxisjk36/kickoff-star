{
  "name": "kickoff-star",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "audit:v4": "node --import tsx scripts/auditV4Integration.ts && node --import tsx scripts/auditProgression.ts && node --import tsx scripts/auditSundayFootball.ts && node --import tsx scripts/auditOctoberLeague.ts && node --import tsx scripts/auditRegionalWorld.ts",
    "audit:season": "node --import tsx scripts/careerSim.ts 2 42 && FORCE_SUNDAY=1 node --import tsx scripts/careerSim.ts 2 42",
    "audit:sunday": "node --import tsx scripts/auditSundayFootball.ts",
    "audit:progression": "node --import tsx scripts/auditProgression.ts",
    "audit:v4-ui": "node --import tsx scripts/auditV4Integration.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
